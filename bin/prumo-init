#!/usr/bin/env bash
# prumo-init: scaffolds .prumo/ in a repository from templates/.prumo/ and wires
# the Prumo gates into its CI.
#
# Never overwrites a file: each template file is created when missing and kept
# when present, so a second run creates nothing and exits 0.
#
# CI is detected from the repository: .gitlab-ci.yml means GitLab, a
# .github/workflows/ directory means GitHub Actions, a Jenkinsfile at the root
# or under pipelines/ means Jenkins, bitbucket-pipelines.yml means Bitbucket
# Cloud. A .github/ directory alone is not CI: it may hold nothing but issue
# templates or a stray .DS_Store. Installing the gates with no CI to run them
# is decorative Prumo, so no CI detected is a refusal unless --force-ci says
# what to do:
#   gitlab    create or extend .gitlab-ci.yml with the include
#   github    create .github/workflows/prumo.yml
#   jenkins   vendor the groovy and print the stage to paste (never edits Groovy)
#   bitbucket create bitbucket-pipelines.yml when the repository has none
#   none      scaffold .prumo/ and wire nothing (prints a warning)
#
# --source picks where CI gets the gates from:
#   vendor  (default) the gates are copied into .prumo/vendor/ with a MANIFEST
#           of sha256, mode and the pack commit; CI verifies the MANIFEST and
#           runs them from there. No network, so a private pack works, and a
#           tag moved upstream cannot change what runs. The vendor directory
#           belongs to the pack: a rerun replaces it when it differs, which is
#           how it is upgraded or restored after drift. The pack must be a git
#           checkout, so the MANIFEST can pin a commit.
#   remote  CI fetches the pack at the v0 tag (needs the pack to be readable
#           by the runner, so a public pack or a token).
#
# GitLab: an include is added (local: .prumo/vendor/ci/gitlab.yml, or the
# remote include of templates/ci/gitlab/prumo.yml). An existing block list
# include gets one more item; any other include form is a refusal with the
# snippet to add by hand.
# GitHub: .github/workflows/prumo.yml is created from
# templates/ci/github/prumo-vendored.yml (vendor) or templates/ci/github/prumo.yml
# (remote, a call to the reusable workflow of the pack).
# Jenkins: vendored only. A Jenkins agent usually cannot read a private pack
# (no token, often no route out), so --source remote is refused for it. The
# groovy is copied to .prumo/vendor/ci/jenkins.groovy and the stage to paste is
# printed: a Jenkinsfile is Groovy, and rewriting someone's pipeline code is
# not this tool's call. A Jenkinsfile that already loads the groovy is reported
# kept and left alone; every other Jenkinsfile keeps getting the snippet until
# it is pasted in.
# Bitbucket Cloud: vendored only, for the same reason. bitbucket-pipelines.yml
# is created from templates/ci/bitbucket/prumo-vendored.yml when the repository
# has none. Bitbucket expands no include, so an existing file is never
# rewritten: that is a refusal with the steps to merge by hand.
#
# Agent gates: with --source vendor the plugin's PreToolUse hooks are vendored
# into .prumo/vendor/hooks/ and registered in the repository's
# .claude/settings.json, so every Claude Code session opened in the repository
# is gated and not only the machines that installed the plugin. A plugin install
# is user scope, and a project settings file cannot enable one, so the hooks
# block is the only path to repository-scope enforcement. Foreign keys and
# foreign hooks in that file are preserved, a rerun writes nothing, and a prumo
# hook deleted by hand comes back. --no-agent-hooks skips it; --source remote
# cannot do it, a session hook has to be a file in the repository.
#
# Checks run before any write: a refusal leaves the repository untouched.
#
# Usage: bin/prumo-init [--source vendor|remote]
#                      [--force-ci gitlab|github|jenkins|bitbucket|none]
#                      [--no-agent-hooks] <repo>
# Exit:  0 ok, 1 refusal, 2 usage error.
set -euo pipefail

HERE="$(cd "$(dirname "$0")" && pwd)"
TEMPLATES="$HERE/../templates/.prumo"
PACK="$(cd "$HERE/.." && pwd)"
GITLAB_TEMPLATE="templates/ci/gitlab/prumo.yml"
GITHUB_WORKFLOW=".github/workflows/prumo.yml"
BITBUCKET_FILE="bitbucket-pipelines.yml"
BITBUCKET_TEMPLATE="templates/ci/bitbucket/prumo-vendored.yml"
VENDOR=".prumo/vendor"
JENKINS_GROOVY="$VENDOR/ci/jenkins.groovy"
JENKINS_TEMPLATE="templates/ci/jenkins/prumo-vendored.groovy"
# Templates whose contents land inside .prumo/vendor/, so the MANIFEST covers
# them and a dirty one is recorded in it. The GitHub and Bitbucket templates
# become the repository's own CI file instead, like the GitLab remote include.
VENDORED_TEMPLATES="templates/ci/gitlab/prumo-vendored.yml $JENKINS_TEMPLATE"
# Everything a vendored pipeline runs. ci/gitlab.yml comes from
# templates/ci/gitlab/prumo-vendored.yml, ci/jenkins.groovy from $JENKINS_TEMPLATE.
VENDOR_FILES="bin/prumo-trace bin/prumo-vendor-verify lib/prumo_trace.py checks/fail-closed.sh checks/metabolic.sh checks/anti-leak.sh"
# The plugin's PreToolUse hooks, vendored by directory glob so a new hook needs
# no edit here. What gets registered comes from the plugin's own hooks.json
# (lib/prumo_agent_hooks.py), so the two cannot drift.
HOOKS_SRC="agent/claude-plugin/hooks"
AGENT_SETTINGS=".claude/settings.json"

USAGE="usage: bin/prumo-init [--source vendor|remote] [--force-ci gitlab|github|jenkins|bitbucket|none] [--no-agent-hooks] <repo>"
usage() {
  echo "$USAGE" >&2
  exit 2
}

force=""
source="vendor"
agent_hooks=1
repo=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    --force-ci)
      [ "$#" -ge 2 ] || usage
      case "$2" in
        gitlab | github | jenkins | bitbucket | none) force="$2" ;;
        *)
          echo "prumo-init: --force-ci takes gitlab|github|jenkins|bitbucket|none, not '$2'." >&2
          usage
          ;;
      esac
      shift 2
      ;;
    --source)
      [ "$#" -ge 2 ] || usage
      case "$2" in
        vendor | remote) source="$2" ;;
        *)
          echo "prumo-init: --source takes vendor|remote, not '$2'." >&2
          usage
          ;;
      esac
      shift 2
      ;;
    --no-agent-hooks)
      agent_hooks=0
      shift
      ;;
    -h | --help)
      echo "$USAGE"
      exit 0
      ;;
    -*)
      echo "prumo-init: unknown flag '$1'." >&2
      usage
      ;;
    *)
      [ -z "$repo" ] || usage
      repo="$1"
      shift
      ;;
  esac
done
[ -n "$repo" ] || usage
if [ ! -d "$repo" ]; then
  echo "prumo-init: repository '$repo' does not exist." >&2
  exit 2
fi
if [ ! -d "$TEMPLATES" ] || [ -z "$(find "$TEMPLATES" -type f | head -1)" ]; then
  echo "prumo-init: REFUSED, no template files in $TEMPLATES. The pack is incomplete." >&2
  exit 1
fi

# jenkins_files <repo>: the repository-relative paths of the Jenkinsfiles, at
# the root or under pipelines/, sorted. One file per pipeline is normal, so
# this can be several.
jenkins_files() {
  local r="$1" f
  for f in "$r/Jenkinsfile" "$r"/Jenkinsfile.* "$r/pipelines/Jenkinsfile" "$r"/pipelines/Jenkinsfile.*; do
    if [ -f "$f" ]; then printf '%s\n' "${f#"$r"/}"; fi
  done | LC_ALL=C sort
}

wire_gitlab=0
wire_github=0
wire_jenkins=0
wire_bitbucket=0
case "$force" in
  gitlab) wire_gitlab=1 ;;
  github) wire_github=1 ;;
  jenkins) wire_jenkins=1 ;;
  bitbucket) wire_bitbucket=1 ;;
  none) ;;
  "")
    if [ -f "$repo/.gitlab-ci.yml" ]; then wire_gitlab=1; fi
    # A .github/ directory alone is not Actions: only workflows/ runs anything.
    if [ -d "$repo/.github/workflows" ]; then wire_github=1; fi
    if [ -n "$(jenkins_files "$repo")" ]; then wire_jenkins=1; fi
    if [ -f "$repo/$BITBUCKET_FILE" ]; then wire_bitbucket=1; fi
    if [ "$wire_gitlab" = 0 ] && [ "$wire_github" = 0 ] &&
      [ "$wire_jenkins" = 0 ] && [ "$wire_bitbucket" = 0 ]; then
      echo "prumo-init: REFUSED, no CI detected in $repo (no .gitlab-ci.yml, no" >&2
      echo ".github/workflows/, no Jenkinsfile, no $BITBUCKET_FILE)." >&2
      echo "Gates that no CI runs are decorative Prumo. Pass --force-ci gitlab, github," >&2
      echo "jenkins or bitbucket to wire one, or --force-ci none to accept it." >&2
      exit 1
    fi
    ;;
esac

# Jenkins and Bitbucket Cloud run the gates from the vendored copy: an agent
# that cannot read a private pack has nothing to fetch, so --source remote is
# refused here rather than producing a pipeline that dies on its first step.
if [ "$source" = remote ] && { [ "$wire_jenkins" = 1 ] || [ "$wire_bitbucket" = 1 ]; }; then
  ci_name="Jenkins"
  if [ "$wire_jenkins" = 0 ]; then ci_name="Bitbucket Cloud"; fi
  echo "prumo-init: REFUSED, $ci_name runs the gates from a copy vendored into the repository." >&2
  echo "The runner cannot fetch a private pack (no token, often no route out), so" >&2
  echo "--source remote has nothing to point at. Run prumo-init again with the default" >&2
  echo "--source vendor: the gates are copied into $VENDOR/ and the pipeline verifies" >&2
  echo "them against their MANIFEST before it runs any of them." >&2
  exit 1
fi

# gitlab <plan|apply> <file>: plan prints the action (create, keep, append,
# insert) or refuses with exit 1; apply performs it.
gitlab() {
  python3 - "$1" "$2" "$GITLAB_TEMPLATE" "$source" "$VENDOR" <<'PY'
import os
import re
import sys

mode, path, template, source, vendor = sys.argv[1:6]
if source == "vendor":
    template = vendor + "/ci/gitlab.yml"
    COMMENT = ["# Prumo gates vendored by prumo-init; rerun it to upgrade."]
    ITEM = ["- local: " + template]
else:
    COMMENT = ["# Prumo gates from prumo-pack, pinned to the v0 tag of the pack."]
    ITEM = ["- remote: https://raw.githubusercontent.com/loonix/prumo-pack/v0/" + template]
SNIPPET = "\n".join(COMMENT + ["include:"] + ["  " + l for l in ITEM]) + "\n"

if not os.path.lexists(path):
    action, text = "create", ""
else:
    with open(path, encoding="utf-8") as fh:
        text = fh.read()
    lines = text.splitlines()
    tops = [i for i, l in enumerate(lines) if re.match(r"^include\s*:", l)]
    if template in text:
        action = "keep"
    elif not tops:
        action = "append"
    elif len(tops) == 1 and re.match(r"^include\s*:\s*(#.*)?$", lines[tops[0]]):
        nxt = next((l for l in lines[tops[0] + 1:]
                    if l.strip() and not l.lstrip().startswith("#")), "")
        m = re.match(r"^(\s+)-\s", nxt)
        action = "insert" if m else "refuse"
    else:
        action = "refuse"
    if action == "refuse":
        print("prumo-init: REFUSED, %s has an include this tool cannot extend safely "
              "(only a block list of '- ' items is extended). Merge this snippet into it by hand "
              "and run again:\n\n%s" % (path, SNIPPET), file=sys.stderr)
        sys.exit(1)

if mode == "plan":
    print(action)
    sys.exit(0)

if action == "create":
    out = SNIPPET
elif action == "append":
    out = text + ("" if text.endswith("\n") or not text else "\n") + "\n" + SNIPPET
elif action == "insert":
    at = tops[0]
    indent = m.group(1)
    item = [indent + l for l in ITEM]
    comment = [indent + l for l in COMMENT]
    out = "\n".join(lines[:at + 1] + comment + item + lines[at + 1:]) + "\n"
else:
    sys.exit(0)
with open(path, "w", encoding="utf-8") as fh:
    fh.write(out)
PY
}

# The pack commit the MANIFEST pins. Resolved before any write.
pack_commit=""
pack_dirty="no"
if [ "$source" = vendor ]; then
  top="$(git -C "$PACK" rev-parse --show-toplevel 2>/dev/null || true)"
  if [ -z "$top" ] || [ "$(cd "$top" && pwd -P)" != "$(cd "$PACK" && pwd -P)" ]; then
    echo "prumo-init: REFUSED, $PACK is not a git checkout of prumo-pack, so there is no" >&2
    echo "commit for .prumo/vendor/MANIFEST to pin. Run it from a clone of the pack." >&2
    exit 1
  fi
  pack_commit="$(git -C "$PACK" rev-parse HEAD)"
  # shellcheck disable=SC2086
  if [ -n "$(git -C "$PACK" status --porcelain -- $VENDOR_FILES $VENDORED_TEMPLATES $HOOKS_SRC)" ]; then
    pack_dirty="yes"
  fi
fi

gitlab_action=""
if [ "$wire_gitlab" = 1 ]; then
  gitlab_action="$(gitlab plan "$repo/.gitlab-ci.yml")" || exit 1
fi

# Bitbucket Cloud expands no include, so an existing pipelines file is never
# rewritten: the steps are merged by hand, and the next run stages the vendor
# copy they run from. Planned before any write, like the GitLab include, so a
# refusal leaves the repository untouched.
bitbucket_action=""
if [ "$wire_bitbucket" = 1 ]; then
  bf="$repo/$BITBUCKET_FILE"
  if [ ! -e "$bf" ] && [ ! -L "$bf" ]; then
    bitbucket_action="create"
  elif [ -f "$bf" ] && grep -qF 'bin/prumo-vendor-verify' "$bf"; then
    bitbucket_action="keep"
  else
    echo "prumo-init: REFUSED, $bf exists and runs no Prumo gate." >&2
    echo "Bitbucket Cloud expands no include, so this tool never rewrites a pipelines" >&2
    echo "file: merge the Prumo steps into it by hand and run prumo-init again, which" >&2
    echo "then stages $VENDOR/ for those steps to run from." >&2
    echo "" >&2
    echo "  The steps to copy are in:" >&2
    echo "    $PACK/$BITBUCKET_TEMPLATE" >&2
    echo "  Each one verifies $VENDOR/ against its MANIFEST before it runs a gate, and" >&2
    echo "  the leak gate stays off until PRUMO_ANTI_LEAK is set to on." >&2
    exit 1
  fi
fi

# The project-scope agent gates are planned before any write, like the CI ones,
# so an unreadable .claude/settings.json refuses with the repository untouched.
agent_hooks_action=""
if [ "$source" = vendor ] && [ "$agent_hooks" = 1 ]; then
  python3 "$PACK/lib/prumo_agent_hooks.py" check "$repo" "$VENDOR" || exit 1
  agent_hooks_action="install"
fi

created=0
updated=0
kept=0
report() {
  printf '%s %s\n' "$1" "$2"
  case "$1" in
    created) created=$((created + 1)) ;;
    updated) updated=$((updated + 1)) ;;
    kept) kept=$((kept + 1)) ;;
  esac
}

while IFS= read -r src; do
  rel=".prumo/${src#"$TEMPLATES"/}"
  dest="$repo/$rel"
  if [ -e "$dest" ] || [ -L "$dest" ]; then
    report kept "$rel"
  else
    mkdir -p "$(dirname "$dest")"
    cp "$src" "$dest"
    report created "$rel"
  fi
done < <(find "$TEMPLATES" -type f | LC_ALL=C sort)

# stage_vendor <dir>: writes the vendor tree and its MANIFEST into <dir>.
stage_vendor() {
  local d="$1" f mode
  for f in $VENDOR_FILES; do
    mkdir -p "$d/$(dirname "$f")"
    cp "$PACK/$f" "$d/$f"
  done
  # Hooks are staged only when the agent gates are on. Files no session runs
  # are dead weight, and the reverse (a registration whose scripts are absent)
  # is worse: python3 on a missing file exits 2, which is the block code.
  if [ "$agent_hooks" = 1 ]; then
    mkdir -p "$d/hooks"
    for f in "$PACK/$HOOKS_SRC"/*.py; do
      cp "$f" "$d/hooks/"
    done
  fi
  mkdir -p "$d/ci"
  cp "$PACK/templates/ci/gitlab/prumo-vendored.yml" "$d/ci/gitlab.yml"
  # The groovy is staged only for a repository that runs Jenkins, so a GitLab
  # or GitHub project does not carry a file no pipeline loads.
  if [ "$wire_jenkins" = 1 ]; then
    cp "$PACK/$JENKINS_TEMPLATE" "$d/ci/jenkins.groovy"
  fi
  {
    echo "# prumo-pack vendored gates. Written by prumo-init; rerun it, do not edit."
    echo "format 1"
    echo "pack_commit $pack_commit"
    echo "pack_dirty $pack_dirty"
    echo "pack_version $(cat "$PACK/VERSION")"
    (cd "$d" && find . -type f | sed 's|^\./||' | LC_ALL=C sort) | while read -r f; do
      if [ -x "$d/$f" ]; then mode=755; chmod 755 "$d/$f"; else mode=644; chmod 644 "$d/$f"; fi
      echo "file $(python3 -c 'import hashlib,sys; print(hashlib.sha256(open(sys.argv[1],"rb").read()).hexdigest())' "$d/$f") $mode $f"
    done
  } >"$d.MANIFEST"
  mv "$d.MANIFEST" "$d/MANIFEST"
}

if [ "$source" = vendor ]; then
  stage="$(mktemp -d "${TMPDIR:-/tmp}/prumo-vendor.XXXXXX")"
  trap 'rm -rf "$stage"' EXIT
  stage_vendor "$stage/vendor"
  dest="$repo/$VENDOR"
  if [ ! -e "$dest" ] && [ ! -L "$dest" ]; then
    mkdir -p "$(dirname "$dest")"
    mv "$stage/vendor" "$dest"
    report created "$VENDOR/MANIFEST"
  elif [ -f "$dest/MANIFEST" ] && cmp -s "$dest/MANIFEST" "$stage/vendor/MANIFEST" \
    && "$stage/vendor/bin/prumo-vendor-verify" "$dest" >/dev/null 2>&1; then
    report kept "$VENDOR/MANIFEST"
  else
    rm -rf "$dest"
    mv "$stage/vendor" "$dest"
    report updated "$VENDOR/MANIFEST"
  fi
fi

if [ "$agent_hooks_action" = install ]; then
  status="$(python3 "$PACK/lib/prumo_agent_hooks.py" install "$repo" "$VENDOR")" || exit 1
  report "$status" "$AGENT_SETTINGS"
elif [ "$source" = vendor ] && [ -f "$repo/$AGENT_SETTINGS" ]; then
  # Opting out deregisters what an earlier run registered, so no hook is left
  # pointing at a script this run did not vendor.
  status="$(python3 "$PACK/lib/prumo_agent_hooks.py" uninstall "$repo" "$VENDOR")" || exit 1
  report "$status" "$AGENT_SETTINGS"
fi

case "$gitlab_action" in
  "") ;;
  keep) report kept ".gitlab-ci.yml" ;;
  create)
    gitlab apply "$repo/.gitlab-ci.yml"
    report created ".gitlab-ci.yml"
    ;;
  *)
    gitlab apply "$repo/.gitlab-ci.yml"
    report updated ".gitlab-ci.yml"
    ;;
esac

if [ "$wire_github" = 1 ]; then
  wf="$repo/$GITHUB_WORKFLOW"
  if [ -e "$wf" ] || [ -L "$wf" ]; then
    report kept "$GITHUB_WORKFLOW"
  else
    mkdir -p "$(dirname "$wf")"
    if [ "$source" = vendor ]; then
      cp "$PACK/templates/ci/github/prumo-vendored.yml" "$wf"
    else
      cp "$PACK/templates/ci/github/prumo.yml" "$wf"
    fi
    report created "$GITHUB_WORKFLOW"
  fi
fi

# Jenkins: never write Groovy. A Jenkinsfile that already loads the vendored
# gates is reported kept and left alone; the ones that do not are collected and
# get the stage to paste printed at the end, every run, until it is pasted in.
jenkins_paste=""
if [ "$wire_jenkins" = 1 ]; then
  jenkins_list="$(jenkins_files "$repo")"
  if [ -z "$jenkins_list" ]; then
    jenkins_paste=" a Jenkinsfile (this repository has none yet)"
  else
    while IFS= read -r jf; do
      if [ -z "$jf" ]; then continue; fi
      if grep -qF "$JENKINS_GROOVY" "$repo/$jf" && grep -qF 'prumoGates' "$repo/$jf"; then
        report kept "$jf"
      elif [ -n "$jenkins_paste" ]; then
        jenkins_paste="$jenkins_paste, $jf"
      else
        jenkins_paste=" $jf"
      fi
    done <<<"$jenkins_list"
  fi
fi

case "$bitbucket_action" in
  "") ;;
  keep) report kept "$BITBUCKET_FILE" ;;
  create)
    cp "$PACK/$BITBUCKET_TEMPLATE" "$repo/$BITBUCKET_FILE"
    report created "$BITBUCKET_FILE"
    ;;
esac

printf 'prumo-init: %d created, %d updated, %d kept.\n' "$created" "$updated" "$kept"
if [ "$force" = "none" ]; then
  echo "prumo-init: WARNING, --force-ci none: no CI wired. The gates bite only once CI runs them." >&2
fi
if [ "$source" = remote ] && { [ "$gitlab_action" = create ] || [ "$gitlab_action" = append ] || [ "$gitlab_action" = insert ]; }; then
  echo "next: the include fetches prumo-pack from GitHub at tag v0; the runner must be able to read it."
fi
if [ "$source" = vendor ]; then
  echo "next: commit $VENDOR/ with the rest; CI verifies it against its MANIFEST (prumo-pack $pack_commit)."
  if [ "$pack_dirty" = yes ]; then
    echo "prumo-init: WARNING, the pack has uncommitted changes in vendored files; the MANIFEST says so." >&2
  fi
fi
if [ -n "$jenkins_paste" ]; then
  echo "next: paste this stage into$jenkins_paste; prumo-init never edits Groovy."
  echo ""
  echo "  stage('Prumo') {"
  echo "    steps {"
  echo "      script {"
  echo "        def prumo = load '$JENKINS_GROOVY'"
  echo "        prumo.prumoGates()"
  echo "      }"
  echo "    }"
  echo "  }"
  echo ""
  echo "      A deploy stage must depend on it: a gate nothing waits for is decoration."
fi
if [ "$agent_hooks_action" = install ]; then
  echo "next: $AGENT_SETTINGS gates every Claude Code session opened in this repository."
  echo "      Commit it. A rerun restores a prumo hook deleted from it by hand."
fi
# A registration git ignores protects this machine alone, which is the decorative
# Prumo the CI detection refuses. Not a refusal here: a repository may keep
# .claude/ local on purpose, so it is said out loud instead of silently accepted.
if [ "$agent_hooks_action" = install ] && git -C "$repo" rev-parse --git-dir >/dev/null 2>&1 &&
  git -C "$repo" check-ignore -q "$AGENT_SETTINGS"; then
  echo "prumo-init: WARNING, $AGENT_SETTINGS is gitignored in this repository, so the agent" >&2
  echo "      gates stay on this machine and reach nobody else. Unignore it, or accept that the" >&2
  echo "      registration is never committed: a gate only one clone carries is decorative Prumo." >&2
fi
if [ "$source" = remote ] && [ "$agent_hooks" = 1 ]; then
  echo "next: no agent gates installed, --source remote leaves no file in the"
  echo "      repository for a session hook to run. Use --source vendor for them."
fi
if [ "$bitbucket_action" = create ]; then
  echo "next: $BITBUCKET_FILE runs the gates on every branch; deployment steps must come after them."
fi
if [ "$created" -gt 0 ]; then
  echo "next: prumo-trace fails until a test is tagged with the id CORE-01 (or the rule is replaced),"
  echo "      and checks/metabolic.sh fails until .prumo/subsystems.yml declares a subsystem."
fi
